{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adhify.com/schemas/release-format/1/boundaries.schema.json",
  "title": "Administrative boundaries (GeoJSON)",
  "description": "A GeoJSON FeatureCollection (RFC 7946) with release metadata as foreign members. Each feature is the boundary of one administrative unit version.",
  "type": "object",
  "required": ["type", "dataset", "version", "schema_version", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "dataset": { "const": "boundaries" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "properties", "geometry"],
        "properties": {
          "type": { "const": "Feature" },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit_code", "valid_from"],
            "properties": {
              "unit_code": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,40}$" },
              "valid_from": { "$ref": "common.schema.json#/$defs/date" }
            }
          },
          "geometry": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "coordinates"],
                "properties": {
                  "type": { "const": "Polygon" },
                  "coordinates": { "$ref": "#/$defs/polygon" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "coordinates"],
                "properties": {
                  "type": { "const": "MultiPolygon" },
                  "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/polygon" }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ]
    },
    "ring": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } },
    "polygon": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ring" } }
  }
}
