{
  "name": "@adhify/release-format",
  "version": "0.0.0",
  "private": true,
  "description": "JSON Schemas and validator for Adhify regional dataset releases.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fixtures:synthetic": "node scripts/build-synthetic-fixtures.ts",
    "validate": "node src/cli.ts"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
