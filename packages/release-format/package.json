{
  "name": "@adhify/release-format",
  "version": "0.0.0",
  "private": true,
  "description": "JSON Schemas and validator for Adhify regional dataset releases.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fixtures:synthetic": "node scripts/build-synthetic-fixtures.ts",
    "validate": "node src/cli.ts",
    "validators": "node scripts/build-validators.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/generated && cp src/generated/validators.js src/generated/validators.d.ts dist/generated/",
    "release:build": "node src/build-cli.ts"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
